# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.
# Leave everything unset (or set HUB_DEMO=1) to run on sample data.

# --- Google Drive and the settings sheet -------------------------------------
# ID of the Drive folder the hub shows (the long string at the end of the folder's URL).
# This is the "Marketing Hub" folder.
HUB_DRIVE_FOLDER_ID=1fkT35ANGDzNExE8VSyEvRu1QbE87loDG
# ID of the Google Sheet with the Links, Announcements and Users tabs.
# This is "_Hub Settings", inside the Marketing Hub folder.
HUB_SETTINGS_SHEET_ID=1w3fw_B5LXguyuGTK7LmwnROwxgsE3oSv-dOUkMRI9_4
# Service account key: the downloaded JSON file's contents, either raw or base64-encoded.
#   base64 -i service-account.json | tr -d '\n'
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Sign-in -----------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- Who can sign in ---------------------------------------------------------
# Anyone at these email domains can sign in (comma-separated).
HUB_ALLOWED_DOMAINS=zingashome.com
# Always admins, even if they're not on the Users tab (comma-separated).
HUB_ADMIN_EMAILS=braden@zingashome.com

# --- Social media uploads ----------------------------------------------------
# ID of the Shared Drive franchisee videos upload into. The service account must be a Manager.
HUB_UPLOADS_FOLDER_ID=
# Share each location's upload folder with that location's people (1 = yes, 0 = no). Default 1.
HUB_SHARE_UPLOAD_FOLDERS=1
# Any long random string; Vercel sends it with the daily folder job.
CRON_SECRET=

# --- Optional ----------------------------------------------------------------
# Shown in the footer as the place to send questions.
HUB_SUPPORT_EMAIL=
# How long Drive and sheet changes take to show up, in seconds. Default 300.
HUB_CACHE_SECONDS=300
# Force sample data even when credentials are set.
HUB_DEMO=
